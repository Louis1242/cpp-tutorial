    {"term": "字面量后缀", "type": "concept", "match": "字面量后缀", "first_def": "c-suffix", "full_def": "c-suffix", "brief": "数字后加 L/f 等字母，明确它的类型。"},
    {"term": "隐式转换与截断", "type": "concept", "match": "隐式转换与截断", "first_def": "c-implicit", "full_def": "c-implicit", "brief": "赋值时自动换类型；double 转 int 只留整数部分。"},
    {"term": "浮点精度", "type": "concept", "match": "浮点精度", "first_def": "deep-p1-04", "full_def": "deep-p1-04", "brief": "二进制只能近似表示多数小数，累加会产生误差。"},
    {"term": "auto 丢失只读属性", "type": "concept", "match": "auto 会丢掉最外层的只读属性", "first_def": "c-auto-const", "full_def": "c-auto-const", "brief": "auto 推导为普通 int 副本，副本仍可修改。"},
    {"term": "数组退化", "type": "concept", "match": "数组退化成", "first_def": "c-array-decay", "full_def": "c-array-decay", "brief": "数组名在推导或传参时变成首地址指针。"},
    {"term": "二维数组", "type": "concept", "match": "二维数组", "first_def": "deep-p2-02", "full_def": "c-multidim", "brief": "数组的数组，用两个下标访问，按行连续存放。"},
    {"term": "strcmp", "type": "name", "match": "strcmp", "first_def": "c-cstrcmp", "full_def": "c-cstrcmp", "brief": "按内容逐字符比较两个 C 风格字符串，返回 0 表示相同。"},
    {"term": "悬空指针", "type": "concept", "match": "悬空指针", "first_def": "c-dangling", "full_def": "c-dangling", "brief": "delete 后仍保存旧地址的指针，再解引用是未定义行为。"},
    {"term": "野指针", "type": "concept", "match": "野指针", "first_def": "c-wild", "full_def": "c-wild", "brief": "未初始化、指向随机地址的指针。"},
    {"term": "指针数组", "type": "concept", "match": "指针数组", "first_def": "c-pointer-array", "full_def": "c-pointer-array", "brief": "装多个指针的数组，例如 int* a[3]。"},
    {"term": "指针的指针", "type": "concept", "match": "指针的指针", "first_def": "c-pointer-pointer", "full_def": "c-pointer-pointer", "brief": "保存另一个指针地址的指针，例如 int**。"},
    {"term": "const 与指针", "type": "concept", "match": "const 放在 \\* 左边", "first_def": "c-const-pointer", "full_def": "c-const-pointer", "brief": "const 在 * 左限制指向的值，在 * 右限制指针本身。"},
    {"term": "优先级", "type": "concept", "match": "优先级与结合性", "first_def": "c-precedence", "full_def": "c-precedence", "brief": "决定同一表达式里先算哪个运算符。"},
    {"term": "自增前后缀", "type": "concept", "match": "i\\+\\+ 与 \\+\\+i", "first_def": "c-incdec", "full_def": "c-incdec", "brief": "后置返回旧值，前置返回新值。"},
    {"term": "逗号表达式", "type": "concept", "match": "逗号表达式", "first_def": "c-comma", "full_def": "c-comma", "brief": "从左往右计算，整个表达式的值是最后一项。"},
    {"term": "switch 贯穿", "type": "concept", "match": "贯穿", "first_def": "c-fallthrough", "full_def": "c-fallthrough", "brief": "case 没写 break 时继续执行下一个 case。"},
    {"term": "循环边界", "type": "concept", "match": "边界怎么选", "first_def": "c-loop-bound", "full_def": "c-loop-bound", "brief": "按是否包含终点选择 < 或 <=，用首尾值代入验证。"},
    {"term": "循环变量作用域", "type": "concept", "match": "只在循环内有效", "first_def": "c-loop-scope", "full_def": "c-loop-scope", "brief": "for 头里声明的变量循环结束即失效。"},
    {"term": "返回引用", "type": "concept", "match": "返回引用", "first_def": "c-return-ref", "full_def": "c-return-ref", "brief": "返回原变量本身而非副本；不能返回局部变量。"},
    {"term": "递归", "type": "concept", "match": "递归", "first_def": "c-recursion", "full_def": "c-recursion", "brief": "函数自己调用自己，必须有终止条件。"},
    {"term": "const 引用参数", "type": "concept", "match": "const 引用", "first_def": "p4-01", "full_def": "p4-01", "brief": "只读地绑定原对象，避免复制大参数。"},
    {"term": "重载二义", "type": "concept", "match": "会二义|二义性", "first_def": "c-overload-default", "full_def": "c-overload-default", "brief": "多个重载版本都能匹配同一次调用，编译器无法选择。"},
    {"term": "static 成员", "type": "name", "match": "static 成员", "first_def": "c-static-member", "full_def": "c-static-member", "brief": "属于类而不属于对象、所有对象共享的成员。"},
    {"term": "成员初始化列表", "type": "concept", "match": "成员初始化列表", "first_def": "c-initlist", "full_def": "c-initlist", "brief": "构造函数冒号后直接初始化成员；const、引用、无默认构造时必须用。"},
    {"term": "对象数组", "type": "concept", "match": "对象数组", "first_def": "c-object-array", "full_def": "c-object-array", "brief": "一排同类对象，每个元素都会各自构造。"},
    {"term": "继承方式", "type": "concept", "match": "继承也有 public", "first_def": "c-inherit-access", "full_def": "c-inherit-access", "brief": "public/protected/private 三种继承改变成员的访问权限。"},
    {"term": "同名成员隐藏", "type": "concept", "match": "同名成员会隐藏", "first_def": "c-name-hiding", "full_def": "c-name-hiding", "brief": "派生类同名成员会挡住基类版本，不是合并。"},
    {"term": "对象切片", "type": "concept", "match": "对象切片", "first_def": "c-slicing", "full_def": "c-slicing", "brief": "派生类对象按值赋给基类对象时，派生部分被切掉。"},
    {"term": "纯虚函数", "type": "concept", "match": "纯虚函数", "first_def": "c-pure-virtual", "full_def": "c-pure-virtual", "brief": "声明 = 0 的虚函数，使类成为抽象类，派生类必须实现。"},
    {"term": "final", "type": "name", "match": "\\bfinal\\b", "first_def": "c-final", "full_def": "c-final", "brief": "禁止派生类继续重写虚函数或继承该类。"},
    {"term": "c_str", "type": "name", "match": "c_str", "first_def": "c-cstr", "full_def": "c-cstr", "brief": "把 std::string 转成只读的 C 风格字符串。"},
    {"term": "empty 与 back", "type": "name", "match": "empty\\(\\)|back\\(\\)", "first_def": "c-empty-back", "full_def": "c-empty-back", "brief": "empty 判断空串，back 取最后一个字符。"},
    {"term": "引用必须初始化", "type": "concept", "match": "引用必须初始化", "first_def": "c-ref-bind", "full_def": "c-ref-bind", "brief": "引用声明时绑定，之后不能改绑，也没有空引用。"},
    {"term": "作用域与生命周期", "type": "concept", "match": "作用域结束不等于对象一定消失", "first_def": "c-scope-lifetime", "full_def": "c-scope-lifetime", "brief": "栈对象随作用域结束销毁，堆对象要等 delete。"},
    {"term": "初始化列表调用基类构造", "type": "syntax", "match": "\\)\\s*:\\s*[A-Z]\\w*\\s*\\(", "first_def": "c-inherit-ctor", "full_def": "c-inherit-ctor", "brief": "派生类构造函数的参数列表后写 : 基类(实参)，把参数交给基类构造。", "note": "阶段五 Part 04 讲写法：冒号位置、为什么必须写、执行顺序。", "exempt": []},
    {"term": "普通成员初始化列表", "type": "syntax", "match": "\\)\\s*:\\s*[a-z_]\\w*\\s*\\(", "first_def": "c-initlist", "full_def": "c-initlist", "brief": "构造函数名后用冒号接 成员(初值)，在对象出生时直接初始化成员。", "note": "阶段四 Part 05 已讲；阶段五 Part 04 只回指，不重复展开。", "exempt": []},
    {"term": "范围 for 写法", "type": "syntax", "match": "for\\s*\\(\\s*int\\s+\\w+\\s*:", "first_def": "c-range-for", "full_def": "c-range-for", "brief": "for (int 元素变量 : 数组) —— 左边是每轮接住元素的副本。", "note": "阶段三 Part 03；要改元素时左边写成引用，放在折叠区。"},
    {"term": "函数模板", "type": "concept", "match": "函数模板", "first_def": "c-preview-s6", "full_def": "c-s6-func-template", "brief": "把参数类型写成占位符 T，调用时由编译器按实参类型替换。", "note": "阶段五预告只分了个类；阶段六 Part 01 讲声明行、推导与实例化。"},
    {"term": "类模板", "type": "concept", "match": "类模板", "first_def": "c-preview-s6", "full_def": "c-s6-class-template", "brief": "把类里的成员类型写成占位符 T，用时在类名后写 <具体类型>。", "note": "阶段六 Part 02 讲定义与显式实参。"},
    {"term": "类型推导", "type": "concept", "match": "类型推导", "first_def": "c-s6-deduce", "full_def": "c-s6-deduce", "brief": "调用模板时，编译器从实参类型反推占位符 T 具体是什么。", "note": "阶段六 Part 01；推导不出唯一结果就编译失败。"},
    {"term": "模板参数", "type": "concept", "match": "模板参数|类型参数", "first_def": "c-s6-param", "full_def": "c-s6-param", "brief": "尖括号里声明的占位名字，如 <typename T> 里的 T。", "note": "阶段六 Part 01；多参数放折叠区。"},
    {"term": "实例化", "type": "concept", "match": "实例化", "first_def": "c-s6-instantiate", "full_def": "c-s6-instantiate", "brief": "编译器按具体类型把模板生成一份真正的函数或类。", "note": "阶段六 Part 01；同一类型只生成一次。"},
    {"term": "显式实参", "type": "concept", "match": "显式实参|显式指定", "first_def": "c-s6-explicit", "full_def": "c-s6-explicit", "brief": "在模板名后的尖括号里直接写具体类型，如 Box<int>。", "note": "阶段六 Part 02；类模板不能省尖括号。"},
    {"term": "异常", "type": "concept", "match": "异常", "first_def": "c-preview-s6", "full_def": "p6-03", "brief": "程序运行时遇到的错误情况，可以抛出并在别处统一处理。", "note": "阶段五预告一句带过；阶段六 Part 03 讲抛出、捕获与栈展开。", "exempt": [{"stage": 5, "part": 1, "channel": "body", "reason": "阶段五析构避坑只给结论‘析构里不要抛异常’，完整讲解在阶段六 Part 03"}]},
    {"term": "抛出", "type": "concept", "match": "抛出", "first_def": "c-s6-throw", "full_def": "c-s6-throw", "brief": "用 throw 把错误情况交给上层，当前函数立即停止。", "note": "阶段六 Part 03；throw 语句写法同时登记为 syntax。"},
    {"term": "捕获", "type": "concept", "match": "捕获", "first_def": "c-s6-trycatch", "full_def": "c-s6-trycatch", "brief": "catch 接住抛出的异常，并按括号里的类型决定谁来处理。", "note": "阶段六 Part 03；Part 04 讲捕获顺序与按引用捕获。"},
    {"term": "异常对象", "type": "concept", "match": "异常对象", "first_def": "c-s6-exception", "full_def": "c-s6-exception", "brief": "throw 后面那个值会被复制成一个对象，沿调用链向上传递。", "note": "阶段六 Part 03。"},
    {"term": "栈展开", "type": "concept", "match": "栈展开", "first_def": "c-s6-unwind", "full_def": "c-s6-unwind", "brief": "异常向上传递时，逐层退出函数并销毁这一层的局部对象。", "note": "阶段六 Part 03；Part 05 用它解释 RAII 为何能释放资源。"},
    {"term": "noexcept", "type": "syntax", "match": "noexcept", "first_def": "c-s6-noexcept", "full_def": "c-s6-noexcept", "brief": "写在函数声明后，承诺这个函数不抛异常；违背承诺会直接终止。", "note": "阶段六 Part 04 只讲一句，不展开细节。"},
    {"term": "异常安全", "type": "concept", "match": "异常安全", "first_def": "c-s6-exception-safety", "full_def": "c-s6-exception-safety", "brief": "出错抛出后，资源仍被释放、对象仍处于可继续使用的状态。", "note": "阶段六 Part 06 综合示例。"},
    {"term": "资源守卫", "type": "concept", "match": "资源守卫|守卫对象", "first_def": "c-s6-raii", "full_def": "c-s6-raii", "brief": "把资源交给一个栈对象保管，离开作用域时由析构函数自动释放。", "note": "阶段六 Part 05。"},
    {"term": "std::runtime_error", "type": "name", "match": "runtime_error", "first_def": "c-s6-exception-type", "full_def": "c-s6-exception-type", "brief": "标准库的运行时错误异常类型，构造时给一句错误说明。", "note": "阶段六 Part 03；头文件 <stdexcept>。"},
    {"term": "std::exception", "type": "name", "match": "std::exception", "first_def": "c-s6-catchbase", "full_def": "c-s6-catchbase", "brief": "所有标准异常的基类，用它可以接住任意一种标准异常。", "note": "阶段六 Part 04；宽泛捕获要放在具体捕获之后。"},
    {"term": "what()", "type": "name", "match": "what\\s*\\(", "first_def": "c-s6-exception-type", "full_def": "c-s6-exception-type", "brief": "异常对象的成员函数，返回构造时写的那句错误说明。", "note": "阶段六 Part 03。"},
    {"term": "stdexcept", "type": "name", "match": "stdexcept", "first_def": "c-s6-exception-type", "full_def": "c-s6-exception-type", "brief": "提供 runtime_error 等标准异常类型的头文件。", "note": "阶段六 Part 03。"},
    {"term": "函数模板声明", "type": "syntax", "match": "template\\s*<\\s*typename\\s+\\w+\\s*>", "first_def": "c-s6-func-template", "full_def": "c-s6-func-template", "brief": "template 开头，尖括号里声明占位类型，下一行才是函数。", "note": "阶段六 Part 01 逐段拆读。"},
    {"term": "类模板显式实参", "type": "syntax", "match": "\\bBox\\s*<\\s*(?:int|std::string)\\s*>", "first_def": "c-s6-explicit", "full_def": "c-s6-explicit", "brief": "类名后写 <具体类型> 才能创建对象。", "note": "阶段六 Part 02。"},
    {"term": "类模板实例化", "type": "syntax", "match": "\\bBox\\s*<\\s*int\\s*>", "first_def": "c-s6-class-template", "full_def": "c-s6-explicit", "brief": "类型名后接 <具体类型>，编译器按这个类型生成一个具体的类。", "note": "阶段六 Part 02；全站的模板实参写法由 check_deps.py 的模板扫描统一把关。", "detect": "template"},
    {"term": "函数模板实例化", "type": "syntax", "match": "larger\\s*<\\s*(?:int|double)\\s*>", "first_def": "c-s6-func-template", "full_def": "c-s6-explicit", "brief": "调用函数模板时，可以在函数名后写 <具体类型>，也可以交给编译器从实参推导。", "note": "阶段六 Part 01；显式写法在 Part 01 的错误示例里出现。", "detect": "template"},
    {"term": "throw 语句", "type": "syntax", "match": "throw\\s+[^\\n;]+;", "first_def": "c-s6-throw", "full_def": "c-s6-throw", "brief": "throw 后面跟要抛出的值，整句以分号结束。", "note": "阶段六 Part 03。"},
    {"term": "try-catch 配对", "type": "syntax", "match": "try\\s*\\{", "first_def": "c-s6-trycatch", "full_def": "c-s6-trycatch", "brief": "try 花括号后必须紧跟一个或多个 catch，中间不能插别的语句。", "note": "阶段六 Part 03。"},
    {"term": "catch 按值", "type": "syntax", "match": "catch\\s*\\(\\s*std::\\w+\\s+\\w+\\s*\\)", "first_def": "c-s6-trycatch", "full_def": "c-s6-trycatch", "brief": "括号里写类型和变量名，异常对象被复制一份给 catch。", "note": "阶段六 Part 03 先用；Part 04 说明为什么改成按引用。"},
    {"term": "catch 按引用", "type": "syntax", "match": "catch\\s*\\(\\s*const\\s+std::\\w+\\s*&\\s*\\w+\\s*\\)", "first_def": "c-s6-trycatch", "full_def": "c-s6-catchref", "brief": "类型后加 &，直接引用抛出的异常对象，不复制、不切片。", "note": "阶段六 Part 03 示例先用；Part 04 解释 & 与 const 为什么这样写。"},
    {"term": "catch 全捕获", "type": "syntax", "match": "catch\\s*\\(\\s*\\.\\.\\.\\s*\\)", "first_def": "c-s6-catchall", "full_def": "c-s6-catchall", "brief": "括号里写 ...，接住任何类型的异常，只能放最后。", "note": "阶段六 Part 04。"}
  ]
}
